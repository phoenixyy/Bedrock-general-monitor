{
  "app": "python app.py",
  "context": {
    "@aws-cdk/aws-s3:keepNotificationInImportedBucket": false,
    "@aws-cdk/customresources:installLatestAwsSdkDefault": false,

    "// ─── 必填参数 ──────────────────────────────────────────": "",
    "notification_email": "your-alert@company.com",
    "model_ids": [
      "anthropic.claude-3-5-sonnet-20241022-v2:0"
    ],
    "model_quotas": {
      "anthropic.claude-3-5-sonnet-20241022-v2:0": 100000
    },

    "// ─── 可选参数（有默认值）─────────────────────────────────": "",
    "input_token_avg_threshold": 50000,
    "dashboard_name": "Bedrock-Operations",

    "// ─── Invocation Logging（设为 false 则跳过）────────────": "",
    "enable_invocation_logging": true,
    "invocation_log_group_name": "/aws/bedrock/invocation-logs",
    "invocation_log_retention_days": 90,
    "invocation_s3_bucket_name": "",

    "// ─── BedrockMantle 监控（可选，适用于 GPT-5.5 等 openai-compatible 端点）────────────": "",
    "// 不填 mantle_model_ids 则不部署本 Stack，与上方 runtime 监控完全解耦": "",
    "mantle_model_ids": [],
    "mantle_project_ids": [],
    "mantle_notification_email": "",
    "mantle_client_error_threshold": 50,
    "mantle_dashboard_name": "Bedrock-Mantle-Operations",
    "mantle_enable_zero_traffic_alarm": false
  }
}
